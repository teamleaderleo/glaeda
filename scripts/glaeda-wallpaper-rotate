#!/usr/bin/env python3
"""Apply the next operator-supplied still wallpaper for this GUI user.

The LaunchAgent installed by glaeda-mini-setup invokes this once every 30 minutes.
Hosts without a logged-in GUI session simply have no wallpaper store and are a
successful no-op.  Images are deliberately supplied outside the Glaeda release:
the fleet operator owns the shared directory and its provenance.
"""

from __future__ import annotations

import fcntl
import base64
import json
import os
import plistlib
import shutil
import subprocess
import tempfile
from pathlib import Path
from urllib.parse import quote


LABEL = "com.teamleaderleo.glaeda.wallpaper"
WALLPAPER_DIR = Path(os.environ.get("GLAEDA_WALLPAPER_DIR", "/Users/Shared/cmux-wallpapers"))
STORE = Path.home() / "Library/Application Support/com.apple.wallpaper/Store/Index.plist"
STATE = Path(os.environ.get(
    "GLAEDA_WALLPAPER_STATE",
    str(Path.home() / "Library/Application Support/com.teamleaderleo.glaeda/wallpaper.json"),
))
LOCK = STATE.with_suffix(".lock")
IMAGE_OPTIONS = base64.b64decode(
    "YnBsaXN0MDDRAQJWdmFsdWVz0gMEBRJVY29sb3JZcGxhY2VtZW500QMG0QcIUl8w0QMJ0goLDBFaY29tcG9uZW50c1pjb2xvclNwYWNl"
    "pA0ODxAjP9BQUFBQUFAjP9paWlpaWlojP+VVVVVVVVUjP/AAAAAAAABPEENicGxpc3QwMF8QF2tDR0NvbG9yU3BhY2VHZW5lcmljUkdC"
    "CAAAAAAAAAEBAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAi0RMUVnBpY2tldctHFdEWF1JpZFRDcm9wCAsSFx0nKi0wMzhDTlNcZW53vcDH"
    "ys3QAAAAAAAAAQEAAAAAAAAAGAAAAAAAAAAAAAAAAAAAANU="
)


def images() -> list[Path]:
    return sorted(
        p for p in WALLPAPER_DIR.iterdir()
        if p.is_file() and p.suffix.lower() in {".jpg", ".jpeg", ".png"}
    ) if WALLPAPER_DIR.is_dir() else []


def file_url(path: Path) -> str:
    return "file://" + quote(str(path), safe="/")


def set_choice(document: dict, image: Path) -> int:
    """Replace every desktop choice, including per-display and per-space entries."""
    changed = 0
    choice = {
        "Provider": "com.apple.wallpaper.choice.image",
        "Files": [{"relative": file_url(image)}],
    }

    def apply_desktop(desktop: object) -> None:
        nonlocal changed
        if not isinstance(desktop, dict):
            return
        content = desktop.get("Content")
        if not isinstance(content, dict):
            return
        choices = content.get("Choices")
        previous = choices[0] if isinstance(choices, list) and choices and isinstance(choices[0], dict) else None
        next_choice = dict(choice)
        if previous and "Configuration" in previous:
            next_choice["Configuration"] = previous["Configuration"]
        content["Choices"] = [next_choice]
        # WallpaperAgent rejects a file choice with "$null" options on macOS 26.  This is
        # the real encoded crop/color payload produced by the system's image picker.
        content["EncodedOptionValues"] = IMAGE_OPTIONS
        changed += 1

    def visit(node: object) -> None:
        if not isinstance(node, dict):
            if isinstance(node, list):
                for item in node:
                    visit(item)
            return
        if isinstance(node.get("Linked"), dict) and "Content" in node["Linked"]:
            node["Desktop"] = node.pop("Linked")
        if isinstance(node.get("Desktop"), dict):
            apply_desktop(node["Desktop"])
            if isinstance(node.get("Desktop"), dict) and isinstance(node["Desktop"].get("Content"), dict):
                node["Type"] = "individual"
        if "Content" in node:
            apply_desktop(node)
        for value in list(node.values()):
            if value is not node.get("Desktop"):
                visit(value)

    visit(document)
    return changed


def main() -> int:
    if not STORE.is_file():
        print("no GUI wallpaper store; skipped")
        return 0
    candidates = images()
    if not candidates:
        print(f"no images in {WALLPAPER_DIR}; skipped")
        return 0
    STATE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with LOCK.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            state = json.loads(STATE.read_text()) if STATE.exists() else {}
        except (OSError, ValueError):
            state = {}
        index = int(state.get("index", 0)) % len(candidates)
        image = candidates[index]
        try:
            document = plistlib.loads(STORE.read_bytes())
        except (OSError, plistlib.InvalidFileException, ValueError) as error:
            print(f"wallpaper store unavailable; skipped ({error})")
            return 0
        changed = set_choice(document, image)
        if not changed:
            print("wallpaper store has no desktop spaces; skipped")
            return 0
        backup = STATE.parent / "Index.plist.previous"
        try:
            shutil.copy2(STORE, backup)
        except OSError as error:
            print(f"could not back up wallpaper store; skipped ({error})")
            return 0
        fd, temporary = tempfile.mkstemp(prefix="Index.plist.", dir=STORE.parent)
        try:
            with os.fdopen(fd, "wb") as stream:
                plistlib.dump(document, stream, fmt=plistlib.FMT_BINARY)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, STORE)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
        STATE.write_text(json.dumps({"index": index + 1, "image": image.name}) + "\n")
        STATE.chmod(0o600)
    try:
        subprocess.run(["/usr/bin/killall", "WallpaperAgent"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        # Unit tests and non-macOS hygiene installs do not have killall.
        pass
    print(f"applied {image.name} ({changed} spaces)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
