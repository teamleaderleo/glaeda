#!/usr/bin/env python3
"""glaeda-route: publish the owned Mac pools' free capacity for cmux CI (glaeda#1174).

    glaeda-route state    [--manifest M] [--repo O/R] [--runners FILE] [--probes FILE] [--address lan|name]
    glaeda-route publish  [same] [--gh PATH] [--yes]
    glaeda-route check    --state FILE [--max-age SECONDS]

The fleet owns placement: a mini that is full, busy or not eligible refuses a job at start (the runner
hook, "refused: capacity: ..." or "refused: node not eligible ..."), and cmux's rescue re-runs a refused
job. So the published state only has to be a good hint, never a reservation: a race costs one retry.

`state` builds the pool-state document (schema glaeda-pool-state/v2, docs/GLAEDA_ROUTE.md) from:

  * GitHub: the repository's self-hosted runners (online, busy, labels);
  * the fleet manifest: each runner member's pool label and capacity units (glaeda_fleet_labels);
  * each member, over SSH, read-only and in parallel (scripts/glaeda_route_probe.sh): which capacity
    units and tokens (persistent-dd for a compile, gui for a GUI job) are free right now, whether a
    fleet build holds the host lock exclusively, the reservation marker, and, at most every
    ELIGIBILITY_TTL seconds per member, the runner hook's read-only eligibility gate (`check`).

A member offers capacity only when it is eligible, not reserved, not held by a fleet build, reachable,
and has a runner online on the pool label. The document carries counts only, never host names.

`publish` writes it to the repository variable GLAEDA_POOL_STATE (dry run without --yes). It is one-shot:
launchd runs it every 20 s on an always-on host that holds no runner (cmux7s-mac-mini). If it stops,
the document ages out and cmux falls back to its own picker.

GitHub goes through the host's own `gh` login (`gh auth login` once; its token lives in gh's store,
never here). That login needs admin on the repository: listing self-hosted runners and setting a
variable both require it.
"""

from __future__ import annotations

import argparse
import base64
import concurrent.futures
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Callable, Dict, List, Optional, Tuple

SCRIPT_DIR = Path(__file__).resolve().parent
STATE_SCHEMA = "glaeda-pool-state/v2"
DEFAULT_REPO = "manaflow-ai/cmux"
STATE_VARIABLE = "GLAEDA_POOL_STATE"
DEFAULT_MANIFEST = Path(os.environ.get("GLAEDA_MINI_FLEET_MANIFEST", "~/.config/glaeda/mini-fleet.json")).expanduser()
# The publisher runs every 20 s; readers treat an older document as missing (cmux allows 90 s).
MAX_AGE_SECONDS = 90
MAX_SKEW_SECONDS = 30
# Leo's order for every job type: std (48 GB) minis, then light (16 GB), then Blacksmith, then GitHub.
CLASS_ORDER = ("std", "light")
POOL_LABEL = re.compile(r"glaeda-(std|light|xl)-xcode-([0-9]+(?:\.[0-9]+)*)")
# glaeda-cmux-runner names instance 0 `<member>-glaeda` and instance K `<member>-glaeda-K`.
RUNNER_NAME = re.compile(r"(?P<member>.+)-glaeda(?:-(?P<instance>[0-9]+))?")
PROBE = SCRIPT_DIR / "glaeda_route_probe.sh"
SSH = "/usr/bin/ssh"
PROBE_TIMEOUT = 15
CHECK_TIMEOUT = 60
# The eligibility gate runs rustc, cargo, zig and xcodebuild, so it is refreshed slowly and a few
# members at a time; the capacity probe is cheap and runs for every member on every tick.
ELIGIBILITY_TTL = 300
CHECKS_PER_TICK = 4
# The runner hook's job classes: a compile costs 2 units plus the persistent-dd token, a GUI job
# 1 unit plus the gui token, anything else 1 unit (glaeda-cmux-runner-hook CLASS_COST).
COMPILE_UNITS, GUI_UNITS = 2, 1
GH_TIMEOUT = 30


class Failure(Exception):
    pass


# ---------------------------------------------------------------- time


def utc(ts: float) -> str:
    return dt.datetime.fromtimestamp(int(ts), dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_utc(value: Any) -> Optional[float]:
    """Seconds since the epoch for an RFC 3339 UTC string with a zone, else None."""
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed.timestamp()


# ---------------------------------------------------------------- fleet


def load_module(name: str, filename: str) -> Any:
    path = SCRIPT_DIR / filename
    loader = importlib.machinery.SourceFileLoader(name, os.fspath(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


labels = load_module("glaeda_fleet_labels", "glaeda_fleet_labels.py")
reservations = load_module("glaeda_reservation", "glaeda_reservation.py")


def pool_key(label: str) -> Optional[Tuple[int, Tuple[int, ...]]]:
    """Sort key for an owned pool label: class rank first, then the newest Xcode."""
    match = POOL_LABEL.fullmatch(label)
    if not match or match.group(1) not in CLASS_ORDER:
        return None
    return CLASS_ORDER.index(match.group(1)), tuple(-int(part) for part in match.group(2).split("."))


def member_of(runner_name: str) -> Optional[str]:
    match = RUNNER_NAME.fullmatch(runner_name)
    return match.group("member") if match else None


def fleet_members(manifest: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    """{member: {pool, class, units, fleet_class, xcode_app, address}} for every runner member, from the
    manifest alone. A member with two pool labels (two Xcodes) belongs to the first in routing order,
    so its capacity is never offered twice."""
    out: Dict[str, Dict[str, Any]] = {}
    hosts = manifest.get("hosts") if isinstance(manifest, dict) else None
    for member in sorted(hosts or {}):
        summary, _ = labels.member_labels(manifest, member, lambda app: True)
        pools = sorted((p for p in (summary or {}).get("pools", []) if pool_key(p)), key=pool_key)
        if not summary or not pools:
            continue
        host = manifest["hosts"][member]
        out[member] = {"pool": pools[0], "class": summary["class"], "units": int(summary["capacityUnits"]),
                       "fleet_class": summary["hardware"],
                       "xcode_app": (summary["xcodeApps"] or [""])[0],
                       "lan": str(host.get("lan_ip") or (f"{host['hostname']}.local" if host.get("hostname") else member))}
    return out


def parse_probe(text: str) -> Dict[str, Any]:
    """The probe's key<TAB>value lines. Complete only when it ended with `probe done`."""
    out: Dict[str, Any] = {"units": {}, "tokens": {}, "complete": False}
    for line in text.splitlines():
        key, _, value = line.partition("\t")
        if key == "unit":
            slot, _, state = value.partition("|")
            if slot.isdigit():
                out["units"][int(slot)] = state
        elif key == "token":
            name, _, state = value.partition("|")
            out["tokens"][name] = state
        elif key == "eligible":
            verdict, _, reason = value.partition("|")
            out["eligible"] = verdict == "yes"
            out["eligible_reason"] = reason
        elif key == "probe" and value == "done":
            out["complete"] = True
        elif key in ("units_total", "host_lock_exclusive", "reservation", "reservation_raw"):
            out[key] = value
    return out


def probe_member(user: str, address: str, units: int, check: Optional[Tuple[str, str]],
                 run: Callable[..., subprocess.CompletedProcess] = subprocess.run) -> Dict[str, Any]:
    """One read-only SSH probe. Never raises: an unreachable member is incomplete, which offers nothing."""
    args = [str(units)] + (["1", check[0], check[1]] if check else [])
    argv = [SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-l", user, address,
            "/bin/bash", "-s", "--", *args]
    try:
        proc = run(argv, input=PROBE.read_bytes(), capture_output=True, check=False,
                   timeout=CHECK_TIMEOUT if check else PROBE_TIMEOUT,
                   env={"PATH": "/usr/bin:/bin", "HOME": os.environ.get("HOME", ""),
                        "SSH_AUTH_SOCK": os.environ.get("SSH_AUTH_SOCK", "")})
    except (OSError, subprocess.TimeoutExpired) as error:
        return {"units": {}, "tokens": {}, "complete": False, "error": type(error).__name__}
    if proc.returncode != 0:
        return {"units": {}, "tokens": {}, "complete": False, "error": f"ssh exit {proc.returncode}"}
    return parse_probe(proc.stdout.decode("utf-8", "replace"))


def member_capacity(member: Dict[str, Any], probe: Dict[str, Any], eligible: Optional[bool],
                    online: int, now: float) -> Dict[str, Any]:
    """Free {units, compile, gui} on one member, and why it offers none."""
    none = {"units": 0, "compile": 0, "gui": 0}
    if not probe.get("complete"):
        return {**none, "why": "unreachable"}
    if eligible is not True:
        return {**none, "why": "not eligible"}
    if probe.get("reservation") == "invalid":
        return {**none, "why": "reserved"}
    raw = probe.get("reservation_raw")
    if raw:
        try:
            marker, error = reservations.parse(base64.b64decode(raw).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            marker, error = None, "unreadable"
        if error or marker is None or reservations.active(marker, now):
            return {**none, "why": "reserved"}
    if probe.get("host_lock_exclusive") != "free":
        return {**none, "why": "fleet build"}
    if online <= 0:
        return {**none, "why": "no runner online"}
    free = sum(1 for slot in range(member["units"]) if probe["units"].get(slot) == "free")
    tokens = probe["tokens"]
    return {"units": free,
            "compile": 1 if tokens.get("persistent-dd") == "free" and free >= COMPILE_UNITS else 0,
            "gui": 1 if tokens.get("gui") == "free" and free >= GUI_UNITS else 0,
            "why": ""}


# ---------------------------------------------------------------- pool state


def runner_rows(runners: Any) -> List[Dict[str, Any]]:
    """Normalize the GitHub runners listing (a page object or a bare list) into typed rows."""
    items = runners.get("runners") if isinstance(runners, dict) else runners
    if not isinstance(items, list):
        raise Failure("runners: not a GitHub runners listing")
    rows = []
    for item in items:
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            continue
        names = [str(label.get("name")) if isinstance(label, dict) else str(label) for label in item.get("labels") or []]
        rows.append({"name": item["name"], "online": item.get("status") == "online",
                     "busy": item.get("busy") is True, "labels": names})
    return rows


COUNT_FIELDS = ("declared", "eligible", "runners", "online", "busy")
FREE_FIELDS = ("units", "compile", "gui")


def build_state(members: Dict[str, Dict[str, Any]], runners: Any, probes: Dict[str, Dict[str, Any]],
                eligibility: Dict[str, Dict[str, Any]], *, repo: str, now: float,
                observed_at: Optional[float] = None) -> Dict[str, Any]:
    """The glaeda-pool-state/v2 document. Pure: every observation is an argument."""
    rows = runner_rows(runners)
    pools: Dict[str, Dict[str, Any]] = {}
    for label in sorted({m["pool"] for m in members.values()}, key=pool_key):
        mine = {name: m for name, m in members.items() if m["pool"] == label}
        on_label = [row for row in rows if label in row["labels"]]
        online = [row for row in on_label if row["online"]]
        free = {field: 0 for field in FREE_FIELDS}
        eligible = 0
        for name, member in mine.items():
            verdict = (eligibility.get(name) or {}).get("eligible")
            eligible += verdict is True
            member_online = sum(1 for row in online if member_of(row["name"]) == name)
            got = member_capacity(member, probes.get(name) or {}, verdict, member_online, now)
            for field in FREE_FIELDS:
                free[field] += got[field]
        match = POOL_LABEL.fullmatch(label)
        pools[label] = {"class": match.group(1), "xcode": match.group(2), "declared": len(mine),
                        "eligible": eligible, "runners": len(on_label), "online": len(online),
                        "busy": sum(1 for row in online if row["busy"]), "free": free}
    order = list(pools)
    return {"schema": STATE_SCHEMA, "repo": repo, "generatedAt": utc(now),
            "observedAt": utc(observed_at if observed_at is not None else now),
            "maxAgeSeconds": MAX_AGE_SECONDS, "order": order, "pools": pools}


def _count(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def validate_state(doc: Any, *, now: float, repo: Optional[str] = None,
                   max_age: int = MAX_AGE_SECONDS) -> Tuple[bool, str]:
    """(usable, reason): the rules every reader applies before trusting the document."""
    if not isinstance(doc, dict):
        return False, "no pool state"
    if doc.get("schema") != STATE_SCHEMA:
        return False, f"pool state schema is {doc.get('schema')!r}, not {STATE_SCHEMA}"
    if repo is not None and str(doc.get("repo") or "").lower() != repo.lower():
        return False, f"pool state is for {doc.get('repo')!r}, not {repo}"
    generated, observed = parse_utc(doc.get("generatedAt")), parse_utc(doc.get("observedAt"))
    if generated is None or observed is None:
        return False, "pool state is undated"
    if generated > now + MAX_SKEW_SECONDS or observed > generated + MAX_SKEW_SECONDS:
        return False, "pool state is dated in the future"
    age = now - min(generated, observed)
    if age > max_age:
        return False, f"pool state is stale ({int(age)} s old, limit {max_age} s)"
    pools, order = doc.get("pools"), doc.get("order")
    if not isinstance(pools, dict) or not isinstance(order, list) or not all(isinstance(x, str) for x in order) \
            or sorted(order) != sorted(pools):
        return False, "pool state is malformed (order and pools disagree)"
    for label, entry in pools.items():
        if not pool_key(str(label)) or not isinstance(entry, dict) or not isinstance(entry.get("free"), dict):
            return False, f"pool state names an unknown or malformed pool {label!r}"
        if not all(_count(entry.get(f)) for f in COUNT_FIELDS) or not all(_count(entry["free"].get(f)) for f in FREE_FIELDS):
            return False, f"pool state {label} has a count that is not a non-negative integer"
        if entry["busy"] > entry["online"] or entry["online"] > entry["runners"]:
            return False, f"pool state {label} counts more busy or online runners than it has"
    return True, f"pool state from {doc['generatedAt']} ({int(age)} s old)"


# ---------------------------------------------------------------- GitHub (gh CLI)


class Gh:
    """GitHub through the host's own `gh` login: no App, no token handled here. Output is parsed,
    never echoed; gh's stderr is reduced to its last line."""

    def __init__(self, gh: str, run: Callable[..., subprocess.CompletedProcess] = subprocess.run) -> None:
        self.gh, self._run = gh, run

    def _call(self, args: List[str], stdin: Optional[str] = None) -> str:
        try:
            proc = self._run([self.gh, *args], input=stdin, capture_output=True, text=True, timeout=GH_TIMEOUT,
                             check=False)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise Failure(f"gh {args[0]} {args[1] if len(args) > 1 else ''}: {type(error).__name__}".strip()) from None
        if proc.returncode != 0:
            tail = (proc.stderr.strip().splitlines() or [f"exit {proc.returncode}"])[-1][:200]
            raise Failure(f"gh {args[0]} {args[1] if len(args) > 1 else ''}: {tail}".strip())
        return proc.stdout

    def runners(self, repo: str) -> List[Dict[str, Any]]:
        out = self._call(["api", "--paginate", f"repos/{repo}/actions/runners?per_page=100",
                          "--jq", ".runners[] | {name, status, busy, labels: [.labels[].name]}"])
        rows = []
        for line in out.splitlines():
            if line.strip():
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    raise Failure("gh api: runners listing is not JSON") from None
        return rows

    def set_variable(self, repo: str, name: str, value: str) -> None:
        # The body goes on stdin: gh variable set reads it there when --body is absent.
        self._call(["variable", "set", name, "--repo", repo], stdin=value)


def find_gh(explicit: Optional[str]) -> str:
    for candidate in (explicit, shutil.which("gh"), "/opt/homebrew/bin/gh", "/usr/local/bin/gh"):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise Failure("gh not found; install it and run `gh auth login` on this host")


# ---------------------------------------------------------------- inputs


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise Failure(f"{path}: {error}") from None


def load_cache(path: Path) -> Dict[str, Dict[str, Any]]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in data.items() if isinstance(v, dict)} if isinstance(data, dict) else {}


def save_cache(path: Path, data: Dict[str, Dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, sort_keys=True), encoding="utf-8")
    os.replace(tmp, path)


def due_checks(members: Dict[str, Dict[str, Any]], cache: Dict[str, Dict[str, Any]], now: float) -> List[str]:
    """Every member never checked, plus the oldest past ELIGIBILITY_TTL, at most CHECKS_PER_TICK of those."""
    never = [m for m in members if m not in cache]
    stale = sorted((float(cache[m].get("at") or 0), m) for m in members
                   if m in cache and now - float(cache[m].get("at") or 0) >= ELIGIBILITY_TTL)
    return never + [m for _, m in stale[:CHECKS_PER_TICK]]


def observe_fleet(manifest: Dict[str, Any], members: Dict[str, Dict[str, Any]], cache: Dict[str, Dict[str, Any]],
                  *, now: float, address: str, probe: Callable[..., Dict[str, Any]] = probe_member
                  ) -> Dict[str, Dict[str, Any]]:
    """Probe every member in parallel; refresh the eligibility cache for the members that are due."""
    user = str(manifest.get("ssh_user") or "")
    if not user:
        raise Failure("manifest has no ssh_user")
    due = set(due_checks(members, cache, now))

    def one(name: str) -> Tuple[str, Dict[str, Any]]:
        member = members[name]
        target = member["lan"] if address == "lan" else name
        check = (member["fleet_class"], member["xcode_app"]) if name in due else None
        return name, probe(user, target, member["units"], check)

    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        results = dict(pool.map(one, sorted(members)))
    for name in due:
        got = results.get(name) or {}
        if got.get("complete") and "eligible" in got:
            cache[name] = {"eligible": got["eligible"], "reason": got.get("eligible_reason", ""), "at": now}
        elif name in cache and now - float(cache[name].get("at") or 0) >= 2 * ELIGIBILITY_TTL:
            cache[name] = {"eligible": None, "reason": "no recent eligibility check", "at": cache[name].get("at", 0)}
    return results


# ---------------------------------------------------------------- main


def main(argv: Optional[List[str]] = None, run: Callable[..., subprocess.CompletedProcess] = subprocess.run,
         now: Callable[[], float] = time.time,
         probe: Callable[..., Dict[str, Any]] = probe_member) -> int:
    parser = argparse.ArgumentParser(prog="glaeda-route", description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("state", "publish"):
        cmd = sub.add_parser(name)
        cmd.add_argument("--repo", default=DEFAULT_REPO)
        cmd.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
        cmd.add_argument("--runners", type=Path, help="read a runners listing (JSON) instead of asking gh")
        cmd.add_argument("--probes", type=Path, help="read {member: probe output text} instead of SSH (tests, replay)")
        cmd.add_argument("--address", choices=("lan", "name"), default="lan",
                         help="lan: the member's lan_ip or <hostname>.local (from a mini on the fleet LAN, "
                              "where the tailnet blocks mini-to-mini SSH); name: the manifest name (tailnet)")
        cmd.add_argument("--cache", type=Path, default=Path.home() / ".local/state/glaeda/route/eligibility.json")
        cmd.add_argument("--gh", help="the gh binary (default: PATH, then Homebrew)")
        if name == "publish":
            cmd.add_argument("--variable", default=STATE_VARIABLE)
            cmd.add_argument("--yes", action="store_true", help="write the variable (default: print what would be written)")
    check = sub.add_parser("check")
    check.add_argument("--state", type=Path, required=True)
    check.add_argument("--repo")
    check.add_argument("--max-age", type=int, default=MAX_AGE_SECONDS)
    args = parser.parse_args(argv)

    try:
        if args.command == "check":
            usable, reason = validate_state(load_json(args.state), now=now(), repo=args.repo, max_age=args.max_age)
            print(("usable: " if usable else "unusable: ") + reason)
            return 0 if usable else 1
        gh: List[Gh] = []

        def client() -> Gh:
            if not gh:
                gh.append(Gh(find_gh(args.gh), run))
            return gh[0]

        manifest = load_json(args.manifest)
        members = fleet_members(manifest)
        started = now()
        runners = load_json(args.runners) if args.runners else client().runners(args.repo)
        cache = load_cache(args.cache)
        if args.probes:
            texts = load_json(args.probes)
            probes = {m: parse_probe(str(texts.get(m) or "")) for m in members}
            for m, got in probes.items():
                if "eligible" in got:
                    cache[m] = {"eligible": got["eligible"], "reason": got.get("eligible_reason", ""), "at": started}
        else:
            probes = observe_fleet(manifest, members, cache, now=started, address=args.address, probe=probe)
            save_cache(args.cache, cache)
        doc = build_state(members, runners, probes, cache, repo=args.repo, now=now(), observed_at=started)
        text = json.dumps(doc, sort_keys=True, separators=(",", ":"))
        summary = "; ".join(f"{label}: {e['online']} online, {e['busy']} busy, free {e['free']['units']} units, "
                            f"{e['free']['compile']} compile, {e['free']['gui']} gui"
                            for label, e in doc["pools"].items()) or "no owned pools"
        if args.command == "state":
            print(json.dumps(doc, indent=2, sort_keys=True))
            return 0
        if not args.yes:
            print(f"would write {args.variable} on {args.repo} ({len(text)} bytes): {summary}")
            print(json.dumps(doc, indent=2, sort_keys=True))
            return 0
        client().set_variable(args.repo, args.variable, text)
        print(f"wrote {args.variable}: {summary}")
        return 0
    except (Failure, OSError) as error:
        name = "" if isinstance(error, Failure) else type(error).__name__ + ": "
        print(f"glaeda-route: {name}{error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
