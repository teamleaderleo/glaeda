#!/usr/bin/env python3
"""glaeda-nightly-only-admit: the admission of the nightly-only dedicated runners (runner.dedicated, label
glaeda-nightly-only-m4pro).

    {python} ~/glaeda-runner/scripts/glaeda-nightly-only-admit --hook {runnerDir}/glaeda-hooks/glaeda-cmux-runner-hook

The runner's job-started hook runs it, as dedicated-admit.sh, after glaeda's own checks (event, repository, fork,
disk floor) with the job's environment. Exit 0 admits the job; exit 1 refuses it (the reason is printed for the job's
log); exit 2 is a usage error, which refuses too.

Leo, 2026-11-01: "ok just dedicate at least one m4 pro mini just completely to the nightly situation idgaf anymore",
then "i thought 7 and 15 were both capable of being dedicated". Those two minis then run only the NEXT nightly, so
this admits only:

  - every job of nightly.yml of manaflow-ai/cmux on refs/heads/nightly-next or refs/heads/main (push, schedule or
    workflow_dispatch), from that same ref's own copy of nightly.yml. A reusable workflow nightly.yml calls (its
    required children) runs under the caller's GITHUB_WORKFLOW_REF, so it is admitted with the caller and only then;
  - the Release compile (release-compile) of cmux-next.yml on a feat-cmux-next push, which gates nightly-next's
    promotion.

It refuses everything else the hook's FEED_FIRST nightly tier (job_tier) ranks first: main's DEV daily publish
(cmux-next-dev-daily.yml), main's nightly-next canary and launch smoke, and every PR, DEV compile and side job. It
also refuses a signing job (the hook's exclusive class, SIGNING_JOBS): such a job must hold the whole mini through
the capacity ledger (GLAEDA_JOB_CLAIM=exclusive), which a dedicated runner never takes, so it keeps its existing
route and claim instead of running here beside other nightly jobs.

It reuses the hook's own pieces (job_tier, dev_compile_refusal, job_class, load_event) by loading the hook file the
runner actually runs, so the two never disagree on what a nightly job is, and the hook's bytes (pinned by the
signing-hook trust list) do not change.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path
from typing import Any

PREFIX = "glaeda-nightly-only-admit"
NIGHTLY_ONLY_LABEL = "glaeda-nightly-only-m4pro"
WHAT = ("NEXT nightly work only: nightly.yml of manaflow-ai/cmux on nightly-next or main (and the workflows it "
        "calls), and cmux-next.yml's release-compile on a feat-cmux-next push")


def load_hook(path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader("glaeda_cmux_runner_hook_for_nightly_only", os.fspath(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def refusal(hook: Any, event_name: str | None, ref: str | None, repository: str | None, event: Any,
            workflow_ref: str | None, job: str | None) -> str | None:
    """Why the nightly-only runner refuses this job, or None to admit it. Pure (given the hook module)."""
    tier = hook.job_tier(event_name, ref, repository, event, workflow_ref, job)
    if tier != hook.TIER_NIGHTLY:
        return f"this runner takes {WHAT}; this job is not nightly work"
    workflow = hook.workflow_file(workflow_ref)
    nightly = ref in hook.NIGHTLY_REFS and workflow_ref == f"{hook.NIGHTLY_WORKFLOW}@{ref}"
    promote = (job == hook.PROMOTE_COMPILE and event_name == "push"
               and hook.dev_compile_refusal(event_name, ref, repository, event, workflow_ref, job) is None)
    if not (nightly or promote):
        # job_tier's other nightly-tier jobs: main's DEV daily publish and main's nightly-next canary and launch smoke
        return f"this runner takes {WHAT}; {workflow or 'this workflow'} is nightly-tier but not the nightly itself"
    if hook.job_class(job or "", repository, hook.DEFAULT_HOME_REPO, workflow)[0] == hook.EXCLUSIVE_CLASS:
        return (f"{workflow} {job} is a signing job: it takes the whole mini through the capacity ledger "
                "(GLAEDA_JOB_CLAIM=exclusive), which a dedicated runner never holds; it keeps its own route")
    return None


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog=PREFIX, description="admit only NEXT nightly work (exit 0), else refuse (1)")
    p.add_argument("--hook", type=Path, required=True, help="the runner's glaeda-cmux-runner-hook")
    args = p.parse_args(argv)
    try:
        hook = load_hook(args.hook)
    except Exception as error:  # noqa: BLE001  (a hook we cannot load refuses: never admit unchecked)
        print(f"{PREFIX}: refused: cannot load the runner hook {args.hook.name} ({type(error).__name__})", flush=True)
        return 1
    env = os.environ
    event = hook.load_event(env.get("GITHUB_EVENT_PATH"))
    why = refusal(hook, env.get("GITHUB_EVENT_NAME"), env.get("GITHUB_REF"), env.get("GITHUB_REPOSITORY"), event,
                  env.get("GITHUB_WORKFLOW_REF"), env.get("GITHUB_JOB"))
    if why:
        print(f"{PREFIX}: refused: {why}", flush=True)
        print(f"::error::{PREFIX}: refused: {why}", flush=True)
        return 1
    print(f"{PREFIX}: admitted: {hook.workflow_file(env.get('GITHUB_WORKFLOW_REF'))} {env.get('GITHUB_JOB')} on "
          f"{env.get('GITHUB_REF')} ({NIGHTLY_ONLY_LABEL})", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
