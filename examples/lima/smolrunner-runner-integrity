#!/bin/bash
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly install_dir="/opt/smolrunner/actions-runner"
readonly entries="/etc/smolrunner/actions-runner.entries"
readonly checksums="/etc/smolrunner/actions-runner.sha256"
readonly runner_work="/var/lib/smolrunner-runner/work"
readonly runner_diag="/var/lib/smolrunner-runner/diag"
readonly jit_launcher="/opt/smolrunner/bin/smolrunner-jit-launcher"
readonly jit_launcher_sha256="9b7cc857f2de1181f64bb067e4d4870e0bcb679d597ec047d885395ac6160996"

[[ "$(/usr/bin/id -u)" == "0" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${install_dir}")" == "root:smolrunner-runner:1775:directory" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${entries}")" == "root:root:444:regular file" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${checksums}")" == "root:root:444:regular file" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${jit_launcher}")" == "root:root:755:regular file" ]]
[[ -L "${install_dir}/_work" && "$(/usr/bin/readlink "${install_dir}/_work")" == "${runner_work}" ]]
[[ -L "${install_dir}/_diag" && "$(/usr/bin/readlink "${install_dir}/_diag")" == "${runner_diag}" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${runner_work}")" == "smolrunner-runner:smolrunner-runner:750:directory" ]]
[[ "$(/usr/bin/stat --format=%U:%G:%a:%F "${runner_diag}")" == "smolrunner-runner:smolrunner-runner:750:directory" ]]

if /usr/bin/find -P "${install_dir}" -xdev -mindepth 1 ! -user root -print -quit | /usr/bin/grep -q .; then
  exit 1
fi
if /usr/bin/find -P "${install_dir}" -xdev -mindepth 1 ! -type l -perm /022 -print -quit | /usr/bin/grep -q .; then
  exit 1
fi

(
  cd "${install_dir}"
  /usr/bin/find -P . -xdev -mindepth 1 -printf '%y %m %P %l\n' | /usr/bin/sort
) | /usr/bin/cmp --silent - "${entries}"
(
  cd "${install_dir}"
  /usr/bin/sha256sum --check --strict --quiet "${checksums}"
)
/usr/bin/printf '%s\n' "${jit_launcher_sha256}  ${jit_launcher}" | /usr/bin/sha256sum --check --status

/usr/bin/printf '%s\n' 'smolrunner-runner-integrity-ok'
